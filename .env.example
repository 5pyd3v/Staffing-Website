APP_NAME="TalentBridge Partners"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=base64:CHANGE_ME_GENERATE_32_RANDOM_BYTES

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=staffing_platform
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

SESSION_NAME=tbp_session
SESSION_LIFETIME=7200
SESSION_SECURE=false

MAIL_DRIVER=log
MAIL_FROM_ADDRESS=notifications@talentbridge.test
MAIL_FROM_NAME="TalentBridge Partners"

UPLOAD_MAX_RESUME_MB=8
UPLOAD_MAX_AVATAR_MB=3
